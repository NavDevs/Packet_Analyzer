{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "builds": [
    {
      "src": "api/run.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": [
          "public/**",
          "python/dpi_types.py",
          "python/sni_extractor.py",
          "python/packet_parser.py"
        ]
      }
    }
  ],
  "routes": [
    { "src": "/(.*)", "dest": "api/run.py" }
  ]
}
